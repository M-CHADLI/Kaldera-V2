# Application
APP_ENV=development
LOG_LEVEL=INFO

# Partenaire anti-fraude (A2A)
PARTENAIRE_URL=http://localhost:8100
PARTENAIRE_JETON=jeton-de-demo

# LLM (Azure AI — Kimi-K2.6), facultatif
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_AI_MODEL=Kimi-K2.6

# Revue de fond du superviseur : regles (défaut), aucune, llm, system_one
KALDERA_REVUE=regles
# Modèle de décision « System One » (hypothèse, voir docs/conception/6-modele-system-one.md)
KALDERA_SYSTEM_ONE_URL=
KALDERA_SYSTEM_ONE_CLE=
KALDERA_SEUIL_CONFIANCE=0.8

# Historique neutralisé (JSONL), désactivé si vide ; clé HMAC de pseudonymisation de id_client
KALDERA_HISTORIQUE=
KALDERA_CLE_HMAC=

# Scénarios affichés par la console (par défaut : eval/scenarios.jsonl)
KALDERA_SCENARIOS=

# Extraction du dossier importé : champs (défaut, sans modèle), llm ou auto
KALDERA_EXTRACTION=champs
